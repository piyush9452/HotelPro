# ---------- Core ----------
PORT=8001
NODE_ENV=development
# Comma-separate multiple origins, e.g. https://hotelpro.vercel.app,https://www.hotelpro.com
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/hotelpro
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=hotelpro_token
# Public URL of this API (used for locally stored upload URLs)
SERVER_PUBLIC_URL=http://localhost:8001

# Cookie policy. Defaults: lax/insecure in development; none/secure in production
# (required when the frontend and API are on different domains).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# Number of reverse proxies in front of the app (Render/Heroku: 1)
# TRUST_PROXY=1

# ---------- Development admin (npm run seed) ----------
# Leave the password empty in development to have one generated and printed.
# Production REQUIRES both values, with a strong password.
SEED_ADMIN_EMAIL=admin@hotelpro.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=HotelPro Admin

# ---------- Hotel policy ----------
HOTEL_NAME=HotelPro
HOTEL_TIMEZONE=Asia/Kolkata
HOTEL_CURRENCY=INR
TAX_RATE=0.12
SERVICE_FEE_RATE=0.03
CHECK_IN_HOUR=14
FREE_CANCELLATION_HOURS=48
PENDING_BOOKING_TTL_MINUTES=15
MAX_NIGHTS=30
MAX_ROOMS_PER_BOOKING=5
BOOKING_WINDOW_DAYS=365

# ---------- Password reset ----------
RESET_TOKEN_TTL_MINUTES=30

# ---------- Email (optional) ----------
# Without SMTP_HOST, emails (including reset links) are printed to this console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HotelPro <no-reply@hotelpro.example>"
ADMIN_NOTIFY_EMAIL=

# ---------- Cloudinary (optional) ----------
# Without these, uploaded images are stored in server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hotelpro

# ---------- Razorpay (optional) ----------
# Without keys, a clearly labelled DEVELOPMENT MOCK gateway is used (never in production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# ENABLE_MOCK_PAYMENTS=true
