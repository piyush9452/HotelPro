              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "description": "Creates a PENDING booking that holds inventory for PENDING_BOOKING_TTL_MINUTES. Prices are computed on the server. Re-sending the same idempotencyKey returns the original booking (200).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"adults\": 2,\n  \"children\": 0,\n  \"rooms\": 1,\n  \"guest\": {\n    \"firstName\": \"Asha\",\n    \"lastName\": \"Rao\",\n    \"email\": \"asha@example.com\",\n    \"phone\": \"9876543210\",\n    \"specialRequests\": \"High floor\"\n  },\n  \"idempotencyKey\": \"{{$guid}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json().data; if (d) pm.collectionVariables.set('bookingId', d._id);"
                ]
              }
