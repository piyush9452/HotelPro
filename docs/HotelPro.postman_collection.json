{
  "info": {
    "name": "HotelPro API",
    "description": "HotelPro REST API. Run \"Health & CSRF > Get CSRF token\" first (the pre-request script also does this automatically). Cookies carry the session; Postman keeps them per domain. Set baseUrl to your API, e.g. http://localhost:8001/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001/api"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "checkIn",
      "value": "2026-12-10"
    },
    {
      "key": "checkOut",
      "value": "2026-12-12"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fetch a CSRF token once and attach it to state-changing requests.",
          "const method = pm.request.method;",
          "if (['POST','PATCH','PUT','DELETE'].includes(method) && !pm.request.url.toString().includes('/payments/webhook')) {",
          "  const send = (token) => pm.request.headers.upsert({ key: 'X-CSRF-Token', value: token });",
          "  const token = pm.collectionVariables.get('csrfToken');",
          "  if (token) { send(token); } else {",
          "    pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/csrf-token', method: 'GET' }, (err, res) => {",
          "      const t = res.json().data.csrfToken; pm.collectionVariables.set('csrfToken', t); send(t);",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health & CSRF",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns 200 when the API and MongoDB are up, 503 otherwise."
          }
        },
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/csrf-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "csrf-token"
              ]
            },
            "description": "Issues the double-submit CSRF token (also set as an HttpOnly cookie)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('csrfToken', pm.response.json().data.csrfToken);"
                ]
              }
            }
          ]
        }
      ]
    },
