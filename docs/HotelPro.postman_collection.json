              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json().data; if (d) pm.collectionVariables.set('orderId', d.orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mock checkout (DEV ONLY)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/mock/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "mock",
                "checkout"
              ]
            },
            "description": "Development only, disabled in production or when Razorpay is configured. Returns a signed paymentId/signature to pass to /verify. No money moves.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"outcome\": \"success\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json().data; if (d && d.paymentId) { pm.collectionVariables.set('paymentId', d.paymentId); pm.collectionVariables.set('signature', d.signature); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "verify"
              ]
            },
            "description": "HMAC-SHA256 signature verified server-side. Idempotent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"paymentId\": \"{{paymentId}}\",\n  \"signature\": \"{{signature}}\"\n}"
            }
          }
        },
        {
          "name": "Report failed/cancelled checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/failure",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "failure"
              ]
            },
            "description": "Records the failure; the booking stays pending so the guest can retry.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"reason\": \"Checkout closed\"\n}"
            }
          }
        },
        {
          "name": "Razorpay webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Razorpay-Signature",
                "value": "<hmac-sha256 of raw body with RAZORPAY_WEBHOOK_SECRET>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/webhook",
              "host": [
